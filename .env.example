# URL de l'API NestJS (apps/api), préfixe /api/v1 compris
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# true = API simulée dans le navigateur (localStorage), utile tant que l'API n'est pas disponible
NEXT_PUBLIC_API_MOCK=true
# URL publique du front (Open Graph, sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Facultatif : connexion Google (Google Identity Services), même identifiant que GOOGLE_CLIENT_ID de l'API
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Facultatif : URL de l'API vue depuis le serveur Next.js (réseau interne), pour servir les sites
# publiés sous /site/<adresse> ; à défaut, NEXT_PUBLIC_API_URL
API_INTERNAL_URL=
